{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/application-local.yml)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/application-local.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git reset --hard*)"
    ]
  }
}
