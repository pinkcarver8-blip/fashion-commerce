{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/application-local.yml)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/application-local.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push *+*)",
      "Bash(git commit* -n*)",
      "Bash(git -c *)",
      "Bash(git -C *)",
      "Bash(git config *)",
      "Edit(.git/hooks/**)",
      "Bash(docker compose*config*)",
      "Bash(docker inspect*)",
      "Bash(docker container inspect*)"
    ],
    "ask": [
      "Bash(git reset --hard*)"
    ]
  }
}
