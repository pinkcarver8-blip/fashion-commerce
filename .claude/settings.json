{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/application-local.yml)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/application-local.yml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push*--no-verify*)",
      "Bash(git push *+*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git -c core.hookspath*)",
      "Bash(git config*core.hooksPath*)",
      "Bash(git config*core.hookspath*)",
      "Edit(.git/hooks/**)"
    ],
    "ask": [
      "Bash(git reset --hard*)"
    ]
  }
}
