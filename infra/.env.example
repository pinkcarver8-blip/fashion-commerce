# infra/.env의 변수 이름 목록(값 없음). 실제 값은 infra/.env에만 둔다(저장소 제외, A5-10).
# `python infra/scripts/init-local-env.py`가 무작위 값으로 infra/.env를 만든다.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
# 고객 토큰 서명 키(base64, 32바이트, R1-01). infra/.env가 이미 있으면 `python infra/scripts/init-local-env.py --add-missing`으로 더한다.
STORE_JWT_SECRET=
