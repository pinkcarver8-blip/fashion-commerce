# 저장소의 텍스트 파일은 LF로 통일한다 (컨테이너의 셸 스크립트가 CRLF면 실행되지 않는다)
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 바이너리
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.woff binary
*.woff2 binary
