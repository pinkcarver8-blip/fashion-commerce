# Lombok 설정(ADR-010 보충, 작업진행.md A5-12). backend 아래 모든 소스에 적용된다.
# 하위 폴더에 lombok.config를 더 두지 않는다(LombokConfigTest가 검사한다).
config.stopBubbling = true

# 값을 아무 데서나 바꾸지 못하게, @Setter·@Data를 쓰면 컴파일이 실패한다.
lombok.setter.flagUsage = error
lombok.data.flagUsage = error

# Lombok이 만든 메서드에 @lombok.Generated를 붙인다.
# 엔티티의 Lombok equals·hashCode·toString을 ArchUnit이 찾는 데 쓴다(CommerceArchitectureRules).
lombok.addLombokGeneratedAnnotation = true

# 소수 타입 예외 표시를 Lombok이 만든 getter에도 복사한다(필드에 단 예외가 getter에도 적용되게).
lombok.copyableAnnotations += io.github.pinkcarver8_blip.commerce.money.AllowDecimal
